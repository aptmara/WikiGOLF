        class WikiPageLoader
        class WikiPageDataFetcher
        class AsyncPathEvaluator
    }

    namespace systems {
        class GameJuiceSystem
        class SlopeVisualizationSystem
        class EnvironmentParticleSystem
        class ParticleRenderSystem
        class TimeOfDaySystem
        class WikiTerrainSystem
        class TerrainGenerator
        class WikiShortestPath
        class WikiClient
        class MapSys
    }

    namespace engine {
        class WikiTextureGenerator
        class SkyboxTextureGenerator
        class SkeletalModel
        class ResourceManager
    }

    WikiGolfScene *-- CameraController
