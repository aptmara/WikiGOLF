// WikiGolf.exe のバージョン情報（エクスプローラーのプロパティ「詳細」に出る）。
// CMake が WIKIGOLF_VERSION から生成する。値は直接書き換えず、-DWIKIGOLF_VERSION=x.y.z で渡す。
#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @WIKIGOLF_VERSION_COMMAS@
 PRODUCTVERSION @WIKIGOLF_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "FileDescription", "@WIKIGOLF_PRODUCT_NAME@"
            VALUE "FileVersion", "@WIKIGOLF_VERSION@"
            VALUE "InternalName", "WikiGolf"
            VALUE "OriginalFilename", "WikiGolf.exe"
            VALUE "ProductName", "@WIKIGOLF_PRODUCT_NAME@"
            VALUE "ProductVersion", "@WIKIGOLF_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
