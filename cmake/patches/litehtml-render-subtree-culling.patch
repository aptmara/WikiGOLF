+void litehtml::render_item::cache_redraw_box()
+{
+    m_redraw_box_valid = false;
+    if(!is_visible())
+    {
+        return;
+    }
+
+    // 折り返しで複数行に分割されるインライン要素(a/span等)は、m_posが
+    // 最後に配置された1行分の位置しか表さない。for_inline_boxesが
+    // 使える場合はそちらで実際に描画される全ての行のボックスを合算する
+    // (通常のテキスト単語やブロック要素はfor_inline_boxesがfalseを
+    // 返すため、従来通りm_pos基準のまま扱われる)。
+    bool hasInlineBox = false;
+    position ownBox;
+    for_inline_boxes([&](const position& box, bool, bool) {
+        if(!hasInlineBox)
+        {
+            ownBox = box;
+            hasInlineBox = true;
+        }
+        else
+        {
+            const pixel_t box_right = std::max(ownBox.right(), box.right());
+            const pixel_t box_bottom = std::max(ownBox.bottom(), box.bottom());
+            ownBox.x = std::min(ownBox.left(), box.left());
+            ownBox.y = std::min(ownBox.top(), box.top());
+            ownBox.width = box_right - ownBox.x;
+            ownBox.height = box_bottom - ownBox.y;
+        }
+        return true;
+    });
+
+    if(hasInlineBox)
+    {
+        m_redraw_box = ownBox;
+    }
+    else
+    {
+        const pixel_t left = m_pos.left() - m_padding.left - m_borders.left;
+        const pixel_t top = m_pos.top() - m_padding.top - m_borders.top;
+        const pixel_t right = m_pos.right() + m_padding.right + m_borders.right;
+        const pixel_t bottom = m_pos.bottom() + m_padding.bottom + m_borders.bottom;
+        m_redraw_box = position(left, top, right - left, bottom - top);
+    }
+    m_redraw_box_valid = true;
+
+    for(auto& child : m_children)
+    {
+        child->cache_redraw_box();
+        if(src_el()->css().get_overflow() != overflow_visible || !child->m_redraw_box_valid ||
+           child->src_el()->css().get_position() == element_position_fixed)
+        {
+            continue;
+        }
+
+        position child_box = child->m_redraw_box;
+        child_box.x += m_pos.x - get_scroll_left();
+        child_box.y += m_pos.y - get_scroll_top();
+        const pixel_t box_right = std::max(m_redraw_box.right(), child_box.right());
+        const pixel_t box_bottom = std::max(m_redraw_box.bottom(), child_box.bottom());
+        m_redraw_box.x = std::min(m_redraw_box.left(), child_box.left());
+        m_redraw_box.y = std::min(m_redraw_box.top(), child_box.top());
+        m_redraw_box.width = box_right - m_redraw_box.x;
+        m_redraw_box.height = box_bottom - m_redraw_box.y;
+    }
+}
