# Ignore everything by default
*

# --- Whitelist: Directories ---
!src/
!src/**
!shaders/
!shaders/**
!libs/
!libs/**
!models/
!models/**
!sounds/
!sounds/**
!Assets/
!Assets/**
!docs/
!docs/**
!.Agents/
!.Agents/**
!licenses/
!licenses/**

# --- Whitelist: Root Files ---
!.gitignore
!Doxyfile
!*.cpp
!*.h
!*.rc
!*.ico

# --- Blacklist: Specific exclusions (override whitelist) ---
# Build & Temp directories (just in case they matched above patterns)
.vs/
.vscode/
build/
out/
Debug/
Release/
x64/
tmp/
dumps/
tools/
.gemini/
.claude/
libs/assimp-6.0.2/static/

# File extensions to ignore
*.txt
*.log
*.tlog
*.obj
*.pdb
*.idb
*.user
*.suo
*.aps
*.opendb
*.db
*.sqlite
*.zip
*.gz
*.slnx
*.vcxproj
*.vcxproj.filters
*.sln

# --- Explicitly Include ---
!CMakeLists.txt
!Assets/data/*.sqlite
Assets/data/jawiki_sdow-001.sqlite

# Doxygen の生成物は設定ファイルと分離し、Git管理へ含めない
docs/doxygen/
docs/doxygen-warnings.log

!cmake/
!cmake/**
!.github/
!.github/workflows/
!.github/workflows/wiki-html.yml
